from datetime import datetime

parking_slots = [None] * 10
vehicle_details = {}
RATE = 20

def display_slots():
    print("\n=====PARKING STATUS=====")
    for i in range(10):
        if parking_slots[i] is None:
            print("Slot", i + 1, ": AVAILABLE")
        else:
            vehicle = parking_slots[i]
            entry_time = vehicle_details[vehicle]["entry_time"]
            print(
                "Slot", i + 1,
                ":", vehicle,
                "| Parked at:",
                entry_time.strftime("%H:%M:%S")
            )
    available = parking_slots.count(None)
    print("--------------------------")
    print("Total Slots     :", 10)
    print("Occupied Slots  :", 10 - available)
    print("Available Slots :", available)

def park_vehicle():
    vehicle_number = input("Enter vehicle number: ")
    # Check duplicate vehicle
    if vehicle_number in vehicle_details:
        print("Vehicle is already parked.")
        return

    for i in range(10):
        if parking_slots[i] is None:

            parking_slots[i] = vehicle_number

            entry_time = datetime.now()

            vehicle_details[vehicle_number] = {
                "slot": i + 1,
                "entry_time": entry_time
            }
            print("\nVehicle parked successfully!")
            print("Vehicle Number:", vehicle_number)
            print("Parking Slot:", i + 1)
            print(
                "Entry Time:",
                entry_time.strftime("%d-%m-%Y %H:%M:%S")
            )
            return
    print("Sorry! Parking is full.")

def remove_vehicle():
    vehicle_number = input("Enter vehicle number: ")
    if vehicle_number not in vehicle_details:
        print("Vehicle not found.")
        return

    details = vehicle_details[vehicle_number]
    slot = details["slot"]
    entry_time = details["entry_time"]
    exit_time = datetime.now()
    duration = exit_time - entry_time
    total_seconds = int(duration.total_seconds())
    hours = total_seconds // 3600
    minutes = (total_seconds % 3600) // 60
    seconds = total_seconds % 60

    total_hours = total_seconds / 3600
    charged_hours = max(1, int(total_hours) + 1)
    fee = charged_hours * RATE
    parking_slots[slot - 1] = None
    del vehicle_details[vehicle_number]

    print("\n========== PARKING RECEIPT ==========")
    print("Vehicle Number :", vehicle_number)
    print("Parking Slot   :", slot)
    print(
        "Entry Time     :",
        entry_time.strftime("%d-%m-%Y %H:%M:%S")
    )
    print(
        "Exit Time      :",
        exit_time.strftime("%d-%m-%Y %H:%M:%S")
    )
    print(
        "Parking Time   :",
        hours, "hours",
        minutes, "minutes",
        seconds, "seconds"
    )
    print("Parking Fee    : ₹", fee)
    print("=====================================")

def search_vehicle():
    vehicle_number = input("Enter vehicle number: ")
    if vehicle_number in vehicle_details:
        details = vehicle_details[vehicle_number]
        print("\nVehicle Found!")
        print("Vehicle Number:", vehicle_number)
        print("Parking Slot:", details["slot"])
        print(
            "Entry Time:",
            details["entry_time"].strftime(
                "%d-%m-%Y %H:%M:%S"
            )
        )
    else:
        print("Vehicle not found.")

while True:
    print("\n==============================")
    print("     SMART PARKING SYSTEM")
    print("==============================")
    print("1. Display Parking Slots")
    print("2. Park Vehicle")
    print("3. Remove Vehicle")
    print("4. Search Vehicle")
    print("5. Exit")

    choice = input("Enter your choice: ")
    if choice == "1":
        display_slots()
    elif choice == "2":
        park_vehicle()
    elif choice == "3":
        remove_vehicle()
    elif choice == "4":
        search_vehicle()
    elif choice == "5":
        print("Thank you!")
        break
    else:
        print("Invalid choice!")
        
